---
import Nav from "../components/navbar/Nav";
import TopButton from "../components/TopButton";
import Pointer from "../components/Pointer";
import Analytics from "@vercel/analytics/astro";
const { title } = Astro.props;
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta
      name="google-site-verification"
      content="TUt3rAj_m9Gi9rXwFI79AS8kSzfBRM7R90tFKoQ5lp0"
    />
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Anuj Jambhale - Full Stack Developer | Game Developer | Software Engineer from Mumbai, India. Expert in JavaScript, React, Node.js, MongoDB, C#, PHP. View Anuj's portfolio, projects, and experience."
    />
    <meta
      name="keywords"
      content="Anuj Jambhale, Anuj, full stack developer, game developer, software engineer, JavaScript developer, React developer, Mumbai developer, portfolio, web development, game development, Anuj Sanjay Jambhale, computer science graduate"
    />
    <meta name="author" content="Anuj Jambhale" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="googlebot" content="index, follow" />
    <meta
      name="subject"
      content="Anuj Jambhale - Full Stack Developer Portfolio"
    />
    <meta name="rating" content="General" />
    <meta name="referrer" content="no-referrer-when-downgrade" />
    <link rel="author" href="https://www.jambhaleanuj.tech" />
    <link rel="me" href="https://www.linkedin.com/in/anuj-jambhale/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Local SEO Meta Tags -->
    <meta name="geo.region" content="IN-MH" />
    <meta name="geo.placename" content="Mumbai" />
    <meta name="geo.position" content="19.0760;72.8777" />
    <meta name="ICBM" content="19.0760, 72.8777" />

    <meta name="generator" content={Astro.generator} />
    <!-- Open Graph Meta Tags -->
    <meta
      property="og:title"
      content={title === "Home"
        ? "Anuj Jambhale - Full Stack Developer | Game Developer"
        : `${title} - Anuj Jambhale`}
    />
    <meta
      property="og:description"
      content="Anuj Jambhale - Full Stack Developer and Game Developer from Mumbai, India. Expert in JavaScript, React, Node.js, MongoDB, C#, PHP. View Anuj's portfolio and projects."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={`${Astro.site}my_photo.png`} />
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content={title === "Home"
        ? "Anuj Jambhale - Full Stack Developer | Game Developer"
        : `${title} - Anuj Jambhale`}
    />
    <meta
      name="twitter:description"
      content="Anuj Jambhale - Full Stack Developer and Game Developer from Mumbai, India. Expert in JavaScript, React, Node.js, and more. View portfolio and projects."
    />
    <meta name="twitter:creator" content="@anujjambhale" />
    <meta name="twitter:image" content={`${Astro.site}my_photo.png`} />
    <!-- Canonical URL -->
    <link rel="canonical" href={Astro.url?.href || Astro.site} />
    <!-- Additional SEO Meta Tags -->
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="googlebot" content="index, follow" />
    <meta
      name="subject"
      content="Anuj Jambhale - Full Stack Developer Portfolio"
    />
    <meta name="rating" content="General" />
    <meta name="referrer" content="no-referrer-when-downgrade" />
    <link rel="author" href="https://www.jambhaleanuj.tech" />
    <link rel="me" href="https://www.linkedin.com/in/anuj-jambhale/" />

    <!-- Preload critical images -->
    <link rel="preload" as="image" href="/my_photo.webp" />

    <!-- Structured Data (JSON-LD) - Person Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Anuj Jambhale",
        "alternateName": "Anuj",
        "jobTitle": "Full Stack Developer",
        "description": "Full Stack Developer and Game Developer from Mumbai, India. Expert in JavaScript, React, Node.js, and game development.",
        "url": "https://www.jambhaleanuj.tech",
        "image": "https://www.jambhaleanuj.tech/my_photo.webp",
        "sameAs": [
          "https://www.linkedin.com/in/anuj-jambhale/",
          "https://www.github.com/jambhaleAnuj",
          "https://twitter.com/anujjambhale"
        ],
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Mumbai",
          "addressCountry": "India"
        },
        "alumniOf": [
          {
            "@type": "CollegeOrUniversity",
            "name": "Tilak College of Science and Commerce, Vashi"
          },
          {
            "@type": "CollegeOrUniversity",
            "name": "SIES College of Arts, Science and Commerce, Nerul"
          }
        ],
        "knowsAbout": [
          "JavaScript",
          "React",
          "Node.js",
          "MongoDB",
          "C#",
          "PHP",
          "Game Development",
          "Web Development",
          "Full Stack Development"
        ],
        "email": "jambhaleanuj@gmail.com"
      }
    </script>

    <!-- WebSite Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Anuj Jambhale - Portfolio",
        "alternateName": "Anuj Portfolio",
        "url": "https://www.jambhaleanuj.tech",
        "author": {
          "@type": "Person",
          "name": "Anuj Jambhale"
        },
        "description": "Official portfolio website of Anuj Jambhale, Full Stack Developer from Mumbai, India"
      }
    </script>
    <!-- FontAwesome CSS -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <title>
      {
        title === "Home"
          ? "Anuj Jambhale | Anuj - Full Stack Developer Mumbai"
          : `${title} | Anuj Jambhale`
      }
    </title>
    <script>
      // On page load or when changing themes, best to add inline in `head` to avoid FOUC
      if (
        localStorage.getItem("theme") === "dark" ||
        (!("theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>
  <body class="bg-primary dark:bg-dk-primary w-full container mx-auto">
    <Analytics />
    <Nav posts={[]} client:visible />
    <div class="container mx-auto px-4">
      <slot />
    </div>
    <TopButton client:only />
    <!-- <Pointer client:only /> -->
  </body>
</html>
