---
import Nav from "../components/navbar/Nav";
import TopButton from "../components/TopButton";
import Pointer from "../components/Pointer";
import Analytics from "@vercel/analytics/astro";
const { title } = Astro.props;
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta
      name="google-site-verification"
      content="TUt3rAj_m9Gi9rXwFI79AS8kSzfBRM7R90tFKoQ5lp0"
    />
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="A portfolio website for a software developer"
    />
    <meta
      name="keywords"
      content="portfolio, software, developer, anuj jambhale, anuj sj, Anuj Sanjay Jambhale"
    />
    <meta name="author" content="Anuj Jambhale" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Anuj Jambhale's Portfolio"
      href={`${Astro.site}rss.xml`}
    />
    <meta name="generator" content={Astro.generator} />
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="A portfolio website for a software developer"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={`${Astro.site}my_photo.png`} />
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta
      name="twitter:description"
      content="A portfolio website for a software developer"
    />
    <meta name="twitter:image" content={`${Astro.site}my_photo.png`} />
    <!-- Canonical URL -->
    <link rel="canonical" href={Astro.url?.href || Astro.site} />
    <script type="text/javascript">
      (function () {
        var css = document.createElement("link");
        css.href =
          "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css";
        css.rel = "stylesheet";
        css.integrity =
          "sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==";
        css.crossOrigin = "anonymous";
        css.referrerPolicy = "no-referrer";
        document.head.appendChild(css);
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/normalize.css@8.0.1/normalize.min.css"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script>
      // On page load or when changing themes, best to add inline in `head` to avoid FOUC
      if (
        localStorage.getItem("theme") === "dark" ||
        (!("theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>
  <body class="bg-primary dark:bg-dk-primary w-full container mx-auto">
    <Analytics />
    <Nav posts={Astro.props.posts} client:visible />
    <div class="container mx-auto px-4">
      <slot />
    </div>
    <TopButton client:only />
    <!-- <Pointer client:only /> -->
  </body>
</html>
