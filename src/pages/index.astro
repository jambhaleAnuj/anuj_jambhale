---
import BaseLayout from "../layouts/BaseLayout.astro";
import { info } from "../data/info";
import Contact from "../components/contact_section/Contact";
import About from "../components/about_section/About";
import Projects from "../components/projects_section/Projects";
import Certifications from "../components/projects_section/Certifications";
import Image from "astro/components/Image.astro";
---

<BaseLayout
  title="Home"
  description="Anuj Jambhale - Full Stack Developer from Mumbai, India. Anuj specializes in JavaScript, React, Node.js, MongoDB, and game development. Explore Anuj's portfolio, projects, and professional experience."
>
  <section class="lg:h-screen lg:m-0 my-20 mx-2" id="home">
    <div
      class="flex flex-col lg:flex-row justify-center items-center h-full space-y-4"
    >
      <div class="profile-pic">
        <picture>
          <!-- 
            TODO: For optimal performance, create these image sizes:
            - my_photo-384.webp (384x384 for desktop)
            - my_photo-160.webp (160x160 for mobile)
            Current: Using same 497x866 image for all sizes (14KB savings possible)
          -->
          <!-- Large screens: 384x384 (lg:h-96 lg:w-96) -->
          <source
            media="(min-width: 1024px)"
            srcset="/my_photo.webp"
            width="384"
            height="384"
          />
          <!-- Small/Medium screens: 160x160 (h-40 w-40) -->
          <source
            media="(max-width: 1023px)"
            srcset="/my_photo.webp"
            width="160"
            height="160"
          />
          <!-- Fallback image -->
          <Image
            src={info.picture}
            alt={info.picture_alt}
            width="384"
            height="384"
            loading="eager"
            class="lg:h-96 lg:w-96 h-40 w-40 rounded-full object-cover object-center"
            fetchpriority="high"
          />
        </picture>
      </div>

      <div class="flex flex-col lg:mx-8 leading-relaxed space-y-4">
        <h1 class="text-3xl lg:text-5xl font-bold font-serif">
          Hi, I'm <span class="bg-clip-text animate-pulse typewriter">
            {info.name}</span
          >
        </h1>
        <h2 class="text-text dark:text-dk-text">{info.brief_description}</h2>
        <p class="text-2xl">
          Based in <span class="text-secondary dark:text-dk-secondary"
            >{info.location}</span
          >
        </p>
      </div>
    </div>
  </section>
  <section class="lg:m-0
        my-20
        mx-2" id="about">
    <About about={info.about} client:visible />
  </section>

  <!-- <section
    class="lg:h-screen lg:m-0 my-20 mx-2 flex-col flex justify-center w-full"
    id="projects"
  > -->
  <!-- <ProjectCarousel projects={info.projects} client:only /> -->
  <!-- </section> -->

  <section
    class="my-20 py-24 px-4 flex-col flex justify-center w-full"
    id="projects"
  >
    <Projects client:only />
  </section>

  <section
    class="my-20 py-24 px-4 flex-col flex justify-center w-full"
    id="certifications"
  >
    <Certifications client:only />
  </section>
  <section
    class="lg:h-screen lg:m-0 my-20 mx-2 flex-col flex justify-center w-full"
    id="contact"
  >
    <div class="flex flex-row justify-center items-center h-full space-y-4">
      <Contact contact={info.contact} size="lg" />
    </div>
  </section>
</BaseLayout>

<head>
  <link rel="preload" as="image" href="/my_photo.webp" />
</head>

<style>
  .typewriter {
    background: linear-gradient(to left, #3333ff, #efff15, #ff0000);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: animation 6s ease-in-out infinite;
    background-size: 400% 100%;
  }

  @keyframes animation {
    0%,
    100% {
      background-position: 0 0;
    }

    50% {
      background-position: 100% 0;
    }
  }

  /* Shadow effect shifting through the image: inspired by https://codepen.io/davidicus/pen/emgQKJ */
  .profile-pic {
    position: relative;
    display: inline-block;
    overflow: hidden;
    border-radius: 100%;
  }

  /* Responsive image optimization */
  .profile-pic picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .profile-pic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Prevent layout shift during load */
    aspect-ratio: 1;
  }

  /* Optimize for different screen sizes */
  @media (max-width: 1023px) {
    .profile-pic {
      width: 10rem; /* h-40 w-40 */
      height: 10rem;
    }
  }

  @media (min-width: 1024px) {
    .profile-pic {
      width: 24rem; /* lg:h-96 lg:w-96 */
      height: 24rem;
    }
  }

  .profile-pic::before {
    position: absolute;
    top: 0;
    left: -75%;
    z-index: 2;
    display: block;
    content: "";
    width: 50%;
    height: 100%;
    background: -webkit-linear-gradient(
      left,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.3) 100%
    );
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.3) 100%
    );
    -webkit-transform: skewX(-25deg);
    transform: skewX(-25deg);
  }
  .profile-pic:hover::before {
    -webkit-animation: shine 0.75s;
    animation: shine 0.75s;
  }
  @-webkit-keyframes shine {
    100% {
      left: 125%;
    }
  }
  @keyframes shine {
    100% {
      left: 125%;
    }
  }
</style>
